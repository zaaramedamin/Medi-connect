# MediConnect API — environment variables
# Copy to server/.env and fill in your values. Never commit the real .env.

# ── Supabase (required) ──────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only; never expose to the browser
SUPABASE_BUCKET=doctor-photos

# ── CORS / client ────────────────────────────────────────────────────
# The browser origin allowed to call the API in production (your Vercel URL).
# Any localhost origin is allowed automatically in development.
CLIENT_ORIGIN=http://localhost:5173

# ── Server ───────────────────────────────────────────────────────────
PORT=3001
# LOG_LEVEL=info               # debug | info | warn | error

# ── Email (optional) — reminders & confirmations no-op without these ──
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
SENDER_EMAIL=onboarding@resend.dev

# ── AI health assistant (optional) ───────────────────────────────────
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
# HF_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct

# ── Background jobs & video (optional) ───────────────────────────────
# JOB_TOKEN=set-a-long-random-secret   # required only for the external cron hook
# CALL_SECRET=set-a-long-random-secret # falls back to the service-role key if unset
# JITSI_DOMAIN=meet.jit.si

# ── Error tracking (optional, reserved) ──────────────────────────────
# SENTRY_DSN=
