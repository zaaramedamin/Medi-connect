# MediConnect client — environment variables
# Copy to client/.env.local and fill in your values.
# Only VITE_* variables are exposed to the browser — never put secrets here.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Deployed API origin (e.g. https://mediconnect-api.onrender.com).
# Leave empty in local development to use the Vite dev proxy.
VITE_API_URL=
